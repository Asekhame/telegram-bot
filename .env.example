# =============================================================================
# mimir-stellar/telegram-bot — copy to .env and fill in. Never commit .env.
# =============================================================================

# ── Profiles (optional) ──────────────────────────────────────────────────────
# MIMIR_PROFILE=mock selects the local mock profile for anything below that is
# left unset: loopback RPC (127.0.0.1:8420), fixture contract ids, an isolated
# data/cursor.mock.json, and placeholder Telegram values so config validation
# passes without credentials. Explicit variables always win over profile
# defaults, and any other profile name fails fast at startup. Leave unset for
# normal Testnet operation — see README "Local mock profile".
# MIMIR_PROFILE=mock

# ── Telegram ─────────────────────────────────────────────────────────────────
# Bot token from @BotFather (/newbot). Required.
BOT_TOKEN=

# Where notifications are posted. A negative id is a group/channel
# (e.g. -1001234567890); a positive id is a private chat. Required.
# See the README for how to find it.
TELEGRAM_CHAT_ID=

# Optional allowlist for the /status command. Comma-separated list of chat ids
# or @channelusernames. When set, /status is silently ignored in any chat not
# on the list. When absent or empty, /status works in any chat the bot can see.
# Example: ALLOWED_CHAT_IDS=-1001234567890,-1009876543210,@mypublicchannel
# ALLOWED_CHAT_IDS=

# ── Mimir Soroban contracts (Stellar Testnet) ────────────────────────────────
# The live deployment the bot watches. These are the same contract ids the
# Mimir app reads as NEXT_PUBLIC_STELLAR_MARKET_CONTRACT_ID /
# NEXT_PUBLIC_STELLAR_SQUAD_CONTRACT_ID — this repo is not a Next.js app, so
# there is no NEXT_PUBLIC_ prefix here. Both are required.
MARKET_CONTRACT_ID=CDV6JXIJCALSXQELCS6YUEWJWG5DFXQK5PJ5I7MWI6KVMQJBC5DLPKZI
SQUAD_CONTRACT_ID=CBPGVXHXLULUBVZ24D6XNSUX7NH45HYXGWHAJFWTBHXYNO72KDRKCDFY

# ── Network ──────────────────────────────────────────────────────────────────
# Soroban RPC is the only endpoint the poller needs: events are read with
# `getEvents`. Horizon is kept for the explorer/tx links and future account
# reads. The passphrase must match the RPC's own getNetwork().passphrase.
STELLAR_RPC_URL=https://soroban-testnet.stellar.org
STELLAR_HORIZON_URL=https://horizon-testnet.stellar.org
STELLAR_NETWORK_PASSPHRASE=Test SDF Network ; September 2015

# Optional explorer origin (no trailing slash required). Defaults to stellar.expert.
# STELLAR_EXPLORER_BASE_URL=https://stellar.expert/explorer

# ── Poller ───────────────────────────────────────────────────────────────────
# How often to ask the RPC for new events. Minimum 5000. Testnet closes a
# ledger about every 5s, so anything under ~15s mostly polls empty pages.
POLL_INTERVAL_MS=30000

# On a cold start with no data/cursor.json, how far back to look before
# tailing. Keep it small — this is a notifier, not a backfiller. ~5 ledgers/25s.
# START_LOOKBACK_LEDGERS=60

# Where the last-seen cursor is persisted. Needs to survive restarts; see the
# "Deployment" section of the README.
# CURSOR_FILE=./data/cursor.json

# Safety valve: most notifications sent in one poll cycle. The rest are
# skipped (logged, cursor commits after the page) so a burst cannot get the bot
# rate-limited by Telegram.
# MAX_NOTIFICATIONS_PER_CYCLE=20

# ── Health endpoint (local HTTP) ─────────────────────────────────────────────
# Loopback-only by default. Supervisors / deploy probes hit GET /health.
# Set HEALTH_PORT=0 to disable the listener (e.g. one-shot tooling).
# HEALTH_HOST=127.0.0.1
# HEALTH_PORT=8787
# After the first successful poll, mark degraded if no success within this
# many milliseconds. 0 disables the stale check.
# HEALTH_STALE_MS=90000

# ── Channel Preview Mode ─────────────────────────────────────────────────────
# When true, notifications sent to Telegram are formatted with a preview badge.
# CHANNEL_PREVIEW_MODE=false

